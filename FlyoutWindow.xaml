<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MoniBrightness.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoniBrightness"
    Title="MoniBrightness">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Padding="12">

        <Border
            Padding="16"
            CornerRadius="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">

            <Grid RowSpacing="14">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="MoniBrightness"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Monitor controls"
                            FontSize="12"
                            Opacity="0.6"/>
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Content="Settings"
                        Click="OpenSettings_Click"
                        VerticalAlignment="Center"/>
                </Grid>

                <!-- Monitors -->
                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl x:Name="MonitorList">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border
                                    Padding="10"
                                    Margin="0,0,0,8"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">

                                    <StackPanel Spacing="6">

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"/>

                                        <!-- Brightness -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="☼"
                                                FontSize="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Brightness"/>

                                            <Slider
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Brightness, Mode=TwoWay}"
                                                ValueChanged="BrightnessSlider_ValueChanged"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding BrightnessText}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Contrast -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Text="◐"
                                                FontSize="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Contrast"/>

                                            <Slider
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="{Binding Contrast, Mode=TwoWay}"
                                                ValueChanged="ContrastSlider_ValueChanged"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding ContrastText}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

                <!-- Presets -->
                <StackPanel
                    Grid.Row="2"
                    Spacing="8">

                    <TextBlock
                        Text="Presets"
                        FontSize="12"
                        Opacity="0.65"/>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="PresetList">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Content="{Binding Name}"
                                        Click="Preset_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>

                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>