<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MoniBrightness.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MoniBrightness"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch">

            <Grid Padding="48,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="1"
                    Spacing="24">

                    <!-- Header -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="MoniBrightness"
                            FontSize="28"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Text="Monitor brightness and contrast"
                            Opacity="0.65"/>
                    </StackPanel>

                    <!-- Monitors -->
                    <TextBlock
                        Text="Monitors"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <!-- Monitor layout -->
                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                        <Canvas
                            x:Name="MonitorLayoutCanvas"
                            Height="190"
                            SizeChanged="MonitorLayoutCanvas_SizeChanged"/>
                    </Border>

                    <Border
                        Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        DataContext="{x:Bind SelectedMonitor, Mode=OneWay}">

                        <StackPanel Spacing="14">

                            <!-- Monitor name -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="{Binding DisplayName}"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                                <Button
                                    Grid.Column="1"
                                    Click="RenameMonitor_Click"
                                    Padding="8,4"
                                    MinWidth="0"
                                    MinHeight="0"
                                    ToolTipService.ToolTip="Rename monitor">

                                    <FontIcon
                                        Glyph="&#xE70F;"
                                        FontSize="12"/>
                                </Button>
                            </Grid>

                            <!-- Brightness -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Brightness"
                                    VerticalAlignment="Center"/>

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Brightness, Mode=TwoWay}"
                                    ValueChanged="BrightnessSlider_ValueChanged"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding BrightnessText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Contrast -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Contrast"
                                    VerticalAlignment="Center"/>

                                <Slider
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Contrast, Mode=TwoWay}"
                                    ValueChanged="ContrastSlider_ValueChanged"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding ContrastText}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Presets -->
                    <TextBlock
                        Text="Presets"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,8,0,0"/>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                        <StackPanel Spacing="16">

                            <StackPanel>
                                <TextBlock
                                    Text="Quick presets"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Apply brightness and contrast to all monitors"
                                    FontSize="12"
                                    Opacity="0.65"/>
                            </StackPanel>

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8">

                                <ItemsControl ItemsSource="{x:Bind Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Content="{Binding Name}"
                                                Click="PresetButton_Click"
                                                ToolTipService.ToolTip="Right-click to delete">

                                                <Button.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Text="Edit"
                                                            Tag="{Binding}"
                                                            Click="EditPreset_Click"/>

                                                        <MenuFlyoutItem
                                                            Text="Update from current"
                                                            Tag="{Binding}"
                                                            Click="UpdatePresetFromCurrent_Click"/>

                                                        <MenuFlyoutSeparator/>

                                                        <MenuFlyoutItem
                                                            Text="Delete"
                                                            Tag="{Binding}"
                                                            Click="DeletePreset_Click"/>
                                                    </MenuFlyout>
                                                </Button.ContextFlyout>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Click="NewPreset_Click">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">

                                        <FontIcon
                                            Glyph="&#xE710;"
                                            FontSize="12"/>

                                        <TextBlock Text="New preset"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Startup -->
                    <TextBlock
                        Text="Startup"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,8,0,0"/>

                    <Border
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">

                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock
                                    Text="Start with Windows"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Launch MoniBrightness automatically when you sign in"
                                    FontSize="12"
                                    Opacity="0.65"/>
                            </StackPanel>

                            <ToggleSwitch
                                x:Name="StartupToggle"
                                Grid.Column="1"
                                IsOn="False"
                                Toggled="StartupToggle_Toggled"
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>

        </ScrollViewer>
    </Grid>
</Page>